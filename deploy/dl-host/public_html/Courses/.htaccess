# Course files are only served through /v.php with a signed, expiring link.
# PHP reads them from disk, so this does not affect the gateway.
<IfModule mod_authz_core.c>
  Require all denied
  # Course teasers stay public (shown on course pages to everyone).
  <FilesMatch "^(tizer|teaser)\.(mp4|webm|jpe?g|png)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(tizer|teaser)\.(mp4|webm|jpe?g|png)$">
    Allow from all
  </FilesMatch>
</IfModule>
