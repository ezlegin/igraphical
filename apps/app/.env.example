
# Subscriptions: keep false until the legacy backfill has run in production (see RELEASE-SUBSCRIPTIONS.md)
SUBSCRIPTIONS_ENABLED=false

# ArvanCloud Object Storage (private bucket) for course files. When set,
# lesson/preview/teaser links become presigned links valid for 3 hours.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
